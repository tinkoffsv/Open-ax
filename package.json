{
  "name": "openax",
  "version": "0.0.0",
  "description": "Architectural memory for AI coding agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openax": "dist/cli.js"
  },
  "files": [
    "dist",
    "prompts"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinkoffsv/Open-ax.git"
  },
  "keywords": [
    "architecture",
